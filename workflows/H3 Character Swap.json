      "title": "Read me",
      "properties": {},
      "widgets_values": [
        "# H3 Character Swap\n**Video + character reference → performance-preserving swap**\n1. Upload a source clip and character image. 2. Choose the SAM subject. 3. Review the expanded mask. 4. Write the prompt and run.\nUse a single continuous shot. All models and setup instructions are listed in the accompanying README."
      ],
      "widgets_values_named": {
        "text": "# H3 Character Swap\n**Video + character reference → performance-preserving swap**\n1. Upload a source clip and character image. 2. Choose the SAM subject. 3. Review the expanded mask. 4. Write the prompt and run.\nUse a single continuous shot. All models and setup instructions are listed in the accompanying README."
      },
