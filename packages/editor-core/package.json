  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "static",
    "README.md",
    "LICENSE",
    "workflow.json",
    "recipes"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/web/src/index.d.ts",
